# Caddy gets and renews the HTTPS certificate by itself, sends only HTTPS (port 80 is only redirected), and passes
# X-Forwarded-Proto / X-Forwarded-For to the app. The app believes those headers only from Caddy.
{$DOMAIN} {
	encode gzip
	# big enough for the Import tab's uploads and phpMyAdmin's imports
	request_body {
		max_size 256MB
	}
	header {
		-Server
	}

	# phpMyAdmin at https://DOMAIN/phpmyadmin. Before every request Caddy asks the app (/api/pma-auth) whether the browser holds a valid
	# JWT (signed with JWT_SECRET from .env) that an admin received at /pma-login. If not, the visitor is sent to /pma-login
	# (and from there to the sign-in page). phpMyAdmin then still asks for the database user and password.
	@pma path /phpmyadmin /phpmyadmin/*
	route @pma {
		forward_auth app:8765 {
			uri /api/pma-auth
		}
		uri strip_prefix /phpmyadmin
		reverse_proxy phpmyadmin:80 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# everything else is the app
	reverse_proxy app:8765 {
		# anything the visitor sent as X-Forwarded-* is replaced by what Caddy saw
		header_up X-Forwarded-For {remote_host}
		transport http {
			dial_timeout 5s
			response_header_timeout 5m
		}
	}
	log {
		output stdout
		format console
	}
}
