# Copy this file to ".env" and change the passwords. ".env" is never uploaded to GitHub.
DB_ROOT_PASSWORD=change-me-root
DB_NAME=florida3pl
DB_USER=florida3pl
DB_PASSWORD=change-me-app

# The address the Rust app uses to reach MariaDB (same user, password and name as above)
DATABASE_URL=mysql://florida3pl:change-me-app@127.0.0.1:3306/florida3pl

# Only for the server (docker-compose.server.yml): the domain people open, for HTTPS
# DOMAIN=orders.example.com
# The secret that signs the JWT admins need to open https://DOMAIN/phpmyadmin. At least 32 random characters, kept secret,
# never committed. Make one with:  openssl rand -hex 32   (changing it signs everybody out of phpMyAdmin)
# JWT_SECRET=
# A browser password prompt in front of /phpmyadmin (checked by Caddy, before anything else). Make the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# and write every $ in the hash as $$ when you put it in this file (docker compose would otherwise read it as a variable).
# PMA_BASIC_AUTH_USER=pma-admin
# PMA_BASIC_AUTH_HASH=
# Optional: the first admin, created automatically the first time the app starts on an EMPTY database (no accounts yet).
# Password 10+ characters, no $ in it. Sign in, change the password, then delete ADMIN_PASSWORD from this file.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

HOST=127.0.0.1
PORT=8765
